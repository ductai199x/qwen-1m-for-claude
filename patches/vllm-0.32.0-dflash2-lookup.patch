         return super().extract_reasoning(model_output, request)
+
+    def _prompt_closed_thinking(self, prompt_token_ids) -> bool:
+        # A chat template can disable thinking itself by rendering an empty, closed think block after the generation
+        # prompt (e.g. mode switches inside the template, invisible to enable_thinking in the request). Generation
+        # then starts in content, so don't wait for a </think> that will never come.
+        return bool(self.thinking_enabled and prompt_token_ids and self.is_reasoning_end(list(prompt_token_ids)))
+
+    def set_prompt_token_ids(self, prompt_token_ids) -> None:
+        if self._prompt_closed_thinking(prompt_token_ids):
+            self.thinking_enabled = False
+
+    def _single_pass_parse(self, text, token_ids, initial_state=None):
+        # non-streaming parse() resets to the configured initial state (REASONING); honour a prompt-closed think block
+        if initial_state is None and not self.thinking_enabled:
+            initial_state = ParserState.CONTENT
+        return super()._single_pass_parse(text, token_ids, initial_state)
+
+    def adjust_initial_state_from_prompt(self, prompt_token_ids) -> None:
+        if self._prompt_closed_thinking(prompt_token_ids):
+            self.thinking_enabled = False
+            self._reset(initial_state=ParserState.CONTENT)
+            self._reasoning_ended = True
